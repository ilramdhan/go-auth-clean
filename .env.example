APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_auth_db
DB_SSL_MODE=disable

# PLACEHOLDER (dev saja). Minimal 32 karakter. Generate: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ISSUER=go-auth-clean
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# --- HTTP ---
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
# Origin eksplisit dipisah koma (tidak boleh *)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# CIDR/IP proxy tepercaya dipisah koma; kosong = X-Forwarded-For diabaikan
TRUSTED_PROXIES=

# --- Rate limit (token bucket, in-memory per instance) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_GLOBAL_PERIOD=1m
RATE_LIMIT_GLOBAL_BURST=50
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_PERIOD=1m
RATE_LIMIT_AUTH_BURST=5
RATE_LIMIT_TTL=10m

# --- Mail (dev: mailpit, UI http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Go Auth <no-reply@localhost>
SMTP_REQUIRE_TLS=false

# --- Security ---
TOTP_ISSUER=go-auth-clean
PASSWORD_RESET_TTL=30m
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5

# --- Google OAuth (opsional; kosongkan semua untuk menonaktifkan) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=

# --- Swagger (default true kecuali production) ---
SWAGGER_ENABLED=true

# --- Finance ---
RECURRING_WORKER_INTERVAL=5m
DEFAULT_CURRENCY=IDR
DEFAULT_TIMEZONE=Asia/Jakarta

# PLACEHOLDER (dev saja, "0123456789abcdef..."). AES-256-GCM key (32 byte base64).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Auth (opsional; default aman bila tidak diisi) ---
# Pepper OTP diturunkan dari ENCRYPTION_KEY (tidak perlu secret baru).
AUTH_OTP_RESEND_COOLDOWN=1m
AUTH_OTP_DAILY_QUOTA=5
AUTH_MAX_SESSIONS=10
AUTH_UNVERIFIED_RETENTION=720h
AUTH_AUDIT_PII_RETENTION=2160h
AUTH_CLEANUP_INTERVAL=1h
AUTH_EMAIL_RATE_LIMIT=10
AUTH_EMAIL_RATE_PERIOD=15m
AUTH_EMAIL_RATE_BURST=5
# 2FA login: umur mfa_token dan maksimum percobaan kode per challenge (mfa_token)
AUTH_MFA_TOKEN_TTL=5m
AUTH_MFA_MAX_ATTEMPTS=5
